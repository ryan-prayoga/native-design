{
  "platform": "apple",
  "era": "2026",
  "frameworks": ["SwiftUI", "RealityKit", "UIKit", "AppKit"],
  "design_language": "Liquid Glass & Spatial Computing",
  "tokens": {
    "spacing": {
      "base": 8,
      "micro": 4,
      "content_padding": 16,
      "section_spacing": 24
    },
    "hit_target": {
      "ios_touch_minimum_pt": 44,
      "watchos_minimum_pt": 38,
      "visionos_gaze_minimum_pt": 60,
      "visionos_element_margin_pt": 16
    },
    "colors": {
      "canvas": "Color(uiColor: .systemBackground)",
      "canvas_elevated": "Color(uiColor: .secondarySystemBackground)",
      "canvas_grouped": "Color(uiColor: .systemGroupedBackground)",
      "text_primary": "Color.primary",
      "text_secondary": "Color.secondary",
      "accent": "Color.accentColor",
      "destructive": "Color.red"
    },
    "typography": {
      "font_family_sans": "SF Pro",
      "font_family_serif": "New York",
      "font_family_mono": "SF Mono",
      "optical_cutoff_pt": 20
    },
    "materials": {
      "liquid_glass": "Refractive dynamic meta-material with specular highlights",
      "contrast_guard_min_ratio": 4.5
    }
  }
}
