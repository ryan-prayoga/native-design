{
  "platform": "google",
  "era": "2026",
  "frameworks": ["Jetpack Compose", "Compose Multiplatform"],
  "design_language": "Material 3 Expressive (M3E)",
  "tokens": {
    "spacing": {
      "base_dp": 8,
      "micro_dp": 4,
      "content_padding_dp": 16,
      "target_separation_dp": 8
    },
    "hit_target": {
      "touch_minimum_dp": 48
    },
    "colors": {
      "surface": "MaterialTheme.colorScheme.surface",
      "surface_container": "MaterialTheme.colorScheme.surfaceContainer",
      "surface_container_high": "MaterialTheme.colorScheme.surfaceContainerHigh",
      "text_primary": "MaterialTheme.colorScheme.onSurface",
      "text_secondary": "MaterialTheme.colorScheme.onSurfaceVariant",
      "accent_primary": "MaterialTheme.colorScheme.primary",
      "destructive": "MaterialTheme.colorScheme.error"
    },
    "typography": {
      "font_family": "Roboto Flex / Google Sans",
      "hct_palette": "Harmonic multi-color wallpaper extraction"
    },
    "shapes": {
      "small_dp": 8,
      "medium_dp": 12,
      "large_dp": 16,
      "extra_large_dp": 28,
      "pill_dp": 9999
    },
    "motion": {
      "scheme": "MotionScheme.expressive()",
      "spring_damping": 0.8
    }
  }
}
