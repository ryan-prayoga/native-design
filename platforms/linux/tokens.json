{
  "platform": "linux",
  "era": "2026",
  "frameworks": ["GTK4", "Libadwaita 1.7+", "Qt6 Kirigami"],
  "design_language": "GNOME 50/51 HIG & Breeze",
  "display_server": "Wayland-Only",
  "tokens": {
    "spacing": {
      "compact_px": 6,
      "base_px": 12,
      "expanded_px": 18
    },
    "hit_target": {
      "touch_minimum_px": 40
    },
    "geometry": {
      "card_corner_radius_px": 12,
      "pill_corner_radius_px": 9999
    },
    "colors": {
      "window_background": "@window_bg_color",
      "view_background": "@view_bg_color",
      "text_primary": "@window_fg_color",
      "text_dimmed": "@shade_color",
      "accent": "@accent_color",
      "accent_background": "@accent_bg_color",
      "destructive": "@error_color"
    },
    "components": {
      "header_bar": "AdwHeaderBar",
      "navigation_switcher": "AdwViewSwitcher",
      "preferences_page": "AdwPreferencesPage",
      "action_row": "AdwActionRow"
    }
  }
}
